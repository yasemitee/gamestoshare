// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// MODELS
// ============================================

model Listing {
  id              String   @id @default(cuid())
  steamId         String   @unique
  username        String?
  platform        Platform @default(STEAM)
  steamProfileUrl String
  description     String?  @db.Text
  location        String
  showSteamId     Boolean  @default(false)
  isActive        Boolean  @default(true)
  views           Int      @default(0)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relazioni
  games ListingGame[]

  @@index([steamId])
  @@index([location])
  @@index([platform])
  @@index([isActive])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("listings")
}

model Game {
  id          String   @id @default(cuid())
  steamAppId  Int      @unique
  name        String
  platform    Platform
  iconUrl     String?
  headerImage String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relazioni
  listings ListingGame[]

  @@unique([steamAppId, platform])
  @@index([name])
  @@map("games")
}

model ListingGame {
  id        String      @id @default(cuid())
  listingId String
  gameId    String
  type      ListingType // LOOKING_FOR o OFFERING
  createdAt DateTime    @default(now())

  // Relazioni
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  game    Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listingId, gameId, type])
  @@map("listing_games")
}

// ============================================
// ENUMS
// ============================================

enum Platform {
  STEAM
  EPIC
  GOG
  XBOX
  PLAYSTATION
  NINTENDO
}

enum ListingType {
  LOOKING_FOR
  OFFERING
}
